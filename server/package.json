{
  "name": "anime-manager-server",
  "type": "module",
  "bin": "dist-bundle/server.cjs",
  "scripts": {
    "dev": "node --watch index.js --no-open",
    "start": "node index.js",
    "bundle": "esbuild index.js --bundle --platform=node --format=cjs --outfile=dist-bundle/server.cjs"
  },
  "dependencies": {
    "express": "^4.21.0",
    "cors": "^2.8.5",
    "axios": "^1.7.0"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^5.16.0",
    "esbuild": "^0.24.0"
  },
  "pkg": {
    "assets": [
      "../client/dist/**/*",
      "../db.json"
    ],
    "targets": [
      "node18-win-x64"
    ],
    "outputPath": "../release"
  }
}
