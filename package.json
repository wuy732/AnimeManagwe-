{
  "name": "anime-manager",
  "version": "1.0.0",
  "description": "本地动漫资源管理器 - 纯离线桌面版",
  "author": "AnimeManager",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cd server && node --watch index.js",
    "dev:client": "cd client && npm run dev",
    "dev:electron": "npm run build && electron .",
    "build": "cd client && npm run build",
    "build:win": "npm run build && electron-builder --win portable --x64",
    "install:all": "npm install && cd server && npm install && cd ../client && npm install"
  },
  "build": {
    "appId": "com.animemanager.app",
    "productName": "AnimeManager",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "server/**/*",
      "client/dist/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "db.json",
        "to": "db.template.json"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "AnimeManager.exe"
    }
  },
  "dependencies": {
    "express": "^4.21.0",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  }
}
